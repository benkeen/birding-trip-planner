{
  "name": "birding-trip-planner",
  "version": "0.1.0",
  "description": "Plan birding trips with eBird target species and hotspot data",
  "main": "dist/main/index.js",
  "homepage": "./",
  "type": "module",
  "author": "Birding Trip Planner",
  "license": "MIT",
  "scripts": {
    "cleanup": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "dev": "npm run cleanup && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "bcrypt": "^5.1.0",
    "better-sqlite3": "^9.0.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "express": "^4.18.2",
    "extract-zip": "^2.0.1",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.5.0",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.4.6",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
